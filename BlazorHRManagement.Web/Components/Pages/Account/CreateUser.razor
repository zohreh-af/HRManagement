@using  MudBlazor
@using Microsoft.AspNetCore.Components.Forms

@page "/account/createuser"


<PageTitle>@TextResources.App_StringKeys_User_Register</PageTitle>
<TitleSync Value="@TextResources.App_StringKeys_User_Register" />



<div class="hold-transition register-page">
    <div class="register-box">

         <NavLink class="register-logo" href="/">
                  <b>Admin</b>LTE
            </NavLink>
        <div class="card">
            <div class="card-body register-card-body">
                <p class="login-box-msg">Register a new membership</p>
   <EditForm FormName="CreateUserForm" Model=_Request OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit">
      <DataAnnotationsValidator />
                         <div class="input-group mb-3">
                       <MudTextField @bind-Value="_Request.Username"
                                     Label="Full name"  
                                     class="form-control"  
                                     Variant="Variant.Outlined" 
                                     Adornment="Adornment.Start" 
                                     AdornmentIcon="@Icons.Material.Filled.Person" />
                        
                    </div>
                    <div class="input-group mb-3">
                        <MudTextField @bind-Value="_Request.Email"
                                     Label="Email"  
                                     class="form-control"  
                                     InputType ="InputType.Email"
                                     Variant="Variant.Outlined" 
                                     Adornment="Adornment.Start" 
                                     AdornmentIcon="@Icons.Material.Filled.Email" />
                    </div>
                    <div class="input-group mb-3">
                        <MudTextField @bind-Value="_Request.Password"
                                      Label="Password"  
                                      class="form-control"
                                      InputType ="InputType.Password"
                                      Variant="Variant.Outlined" 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Key" />
                    </div>
                    <div class="input-group mb-3">
                        <MudTextField @bind-Value="_Request.Password2"
                                      Label="Retype password"  
                                      class="form-control"
                                      InputType ="InputType.Password"
                                      Variant="Variant.Outlined" 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Key" />
                    </div>
                    <div class="row">
                        <div class="col-8">
                            <div class="icheck-primary">
                                <MudCheckBox @bind-Value="IsAgreedTerms"
                                            id="agreeTerms"
                                            name="terms"
                                            Label="Default">
                                     <label for="agreeTerms">
                                            I agree to the <a href="#">terms</a>
                                     </label>
                                </MudCheckBox>
                            </div>
                        </div>
                        <!-- /.col -->
                        <div class="col-4">
                             <MudIconButton ButtonType="ButtonType.Submit"
                                            Variant="Variant.Filled" 
                                            Color="Color.Primary" 
                                            Class="btn btn-primary btn-block btn-flat">
                                            @TextResources.APP_StringKeys_Register_User
                             </MudIconButton>
                        </div>
                        <!-- /.col -->
                    </div>
                </EditForm>

                <div class="social-auth-links text-center">
                    <p>- OR -</p>
                    <a href="#" class="btn btn-block btn-primary">
                        <i class="fab fa-facebook mr-2"></i>
                        Sign up using Facebook
                    </a>
                    <a href="#" class="btn btn-block btn-danger">
                        <i class="fab fa-google-plus mr-2"></i>
                        Sign up using Google+
                    </a>
                </div>
                <NavLink class="register-logo" href="/Account/Login">
                I already have a membership
            </NavLink>
                <a href="login.html" class="text-center"></a>
            </div>
            <!-- /.form-box -->
        </div><!-- /.card -->
    </div>
    <!-- /.register-box -->
   </div>

 @if (IsInvalid) 
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="my-2">@MassageText</MudAlert>
}

@if (!string.IsNullOrWhiteSpace(Response.Message))
{
    <MudAlert Severity="@(Response.Result ? Severity.Success : Severity.Error)" Dense="true" Class="my-2">@Response.Message</MudAlert>
}

@if (IsLoading)
{
    <MudOverlay Visible=true DarkBackground="true" Absolute="true">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary">
            <ChildContent>@TextResources.APP_StringKeys_Loading</ChildContent>
        </MudProgressCircular>
    </MudOverlay>

}