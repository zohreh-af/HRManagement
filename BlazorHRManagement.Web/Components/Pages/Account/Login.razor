@using Microsoft.AspNetCore.Authorization
@page "/account/Login"
@attribute [AllowAnonymous]



<PageTitle>@TextResources.App_StringKeys_User_Login</PageTitle>
<TitleSync Value="Login" />

<div class="hold-transition login-page">
    <div class="login-box">
         <NavLink class="register-logo" href="/">
                <b>Admin</b>LTE
            </NavLink>
        <div class="card">
            <div class="card-body login-card-body">
                <p class="login-box-msg">Sign in to start your session</p>

                       <EditForm FormName="LoginUserForm" Model=_Request OnValidSubmit="OnValidSubmit" OnInvalidSubmit="OnInvalidSubmit">
      <DataAnnotationsValidator />
                    <div class="input-group mb-3">
                        <MudTextField @bind-Value="_Request.Email"
                                     Label="Email"  
                                     InputType ="InputType.Email"
                                     Variant="Variant.Outlined" 
                                     Adornment="Adornment.Start" 
                                     AdornmentIcon="@Icons.Material.Filled.Email" />
                    </div>
                    <div class="input-group mb-3">
                        <MudTextField @bind-Value="_Request.Password"
                                      Label="Password"  
                                      InputType ="InputType.Password"
                                      Variant="Variant.Outlined" 
                                      Adornment="Adornment.Start" 
                                      AdornmentIcon="@Icons.Material.Filled.Key" />
                    </div>
                    <div class="row">
                        <div class="col-8">
                            <div class="icheck-primary">
                                <input type="checkbox" id="remember">
                                <label for="remember">
                                    Remember Me
                                </label>
                            </div>
                        </div>
                        <!-- /.col -->
                        <div class="col-4">
                            <MudButton ButtonType="ButtonType.Submit"
                                            Variant="Variant.Filled" 
                                            Color="Color.Primary" 
                                            Class="btn btn-primary btn-block btn-flat">
                                            @TextResources.APP_StringKeys_LoginUser
                             </MudButton>
                        </div>
                        <!-- /.col -->
                    </div>
                                </EditForm>

                <div class="social-auth-links text-center mb-3">
                    <p>- OR -</p>
                    <a href="#" class="btn btn-block btn-primary">
                        <i class="fab fa-facebook mr-2"></i> Sign in using Facebook
                    </a>
                    <a href="#" class="btn btn-block btn-danger">
                        <i class="fab fa-google-plus mr-2"></i> Sign in using Google+
                    </a>
                </div>
                <!-- /.social-auth-links -->

                <p class="mb-1">
                    <a href="#">I forgot my password</a>
                </p>
                <p class="mb-0">
                    <a href="register.html" class="text-center">Register a new membership</a>
                </p>
            </div>
            <!-- /.login-card-body -->
        </div>
    </div>
</div>

@if (IsInvalid)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="my-2">@MassageText</MudAlert>
}

@if (!string.IsNullOrWhiteSpace(Response.Message))
{
    <MudAlert Severity="@(Response.Result ? Severity.Success : Severity.Error)" Dense="true" Class="my-2">@Response.Message</MudAlert>
}

@if (IsLoading)
{
    <MudOverlay Visible=true DarkBackground="true" Absolute="true">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary">
            <ChildContent>@TextResources.APP_StringKeys_Loading</ChildContent>
        </MudProgressCircular>
    </MudOverlay>

}             
