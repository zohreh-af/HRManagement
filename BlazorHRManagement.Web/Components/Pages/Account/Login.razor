@using MudBlazor
@page "/account/Login"


<PageTitle>@TextResources.App_StringKeys_User_Login</PageTitle>
<div class="container">
	<div class="screen">
		<div class="screen__content">
    <EditForm class="login" 
			  Formname="UserLoginForm" 
			  Model=_Request 
			  OnValidSubmit="OnValidSubmit" 
			  OnInvalidSubmit="OnInvalidSubmit">

        <DataAnnotationsValidator />

						<div class="login__field">

							<MudTextField Label="@TextResources.APP_StringKeys_Username"
										  InputType="InputType.Text"
										  @bind-Value="_Request.Username"
										  Adornment="Adornment.Start" 
										  AdornmentIcon="@Icons.Material.Filled.Person" 
										  AdornmentColor="Color.Primary" />
						</div>
						<div class="login__field">

							<MudTextField Label="@TextResources.APP_StringKeys_Password"
										  InputType="InputType.Password"
										  @bind-Value="_Request.Password"
										  Adornment="Adornment.Start" 
										  AdornmentIcon="@Icons.Material.Filled.Person" 
										  AdornmentColor="Color.Primary" />
						</div>
						  <MudIconButton class="login__submit"
							  ButtonType="ButtonType.Submit" 
							  StartIcon ="@Icons.Material.Filled.ArrowForwardIos"
							  Variant="Variant.Filled" 
							  Color="Color.Primary">
							  <span class="button__text">
								  @TextResources.App_StringKeys_User_Login
								  </span>
								  </MudIconButton>				
			  </EditForm>
			</div>
		</div>
		<div class="screen__background">
			<span class="screen__background__shape screen__background__shape4"></span>
			<span class="screen__background__shape screen__background__shape3"></span>		
			<span class="screen__background__shape screen__background__shape2"></span>
			<span class="screen__background__shape screen__background__shape1"></span>
		</div>		
	</div>

@if (IsInvalid)
{
    <MudAlert Severity="Severity.Error" Dense="true" Class="my-2">@MassageText</MudAlert>
}

@if (!string.IsNullOrWhiteSpace(Response.Message))
{
    <MudAlert Severity="@(Response.Result ? Severity.Success : Severity.Error)" Dense="true" Class="my-2">@Response.Message</MudAlert>
}

@if (IsLoading)
{
    <MudOverlay Visible=true DarkBackground="true" Absolute="true">
        <MudProgressCircular Size="Size.Large" Indeterminate="true" Color="Color.Primary">
            <ChildContent>@TextResources.APP_StringKeys_Loading</ChildContent>
        </MudProgressCircular>
    </MudOverlay>

}                       