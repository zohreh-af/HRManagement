@using BlazorHRManagement.Web.Components.Pages
@inherits LayoutComponentBase

<div class="wrapper">
            @if (IsAutheticated)
            {
                <NavMenu />
                <Sidebar />
            }
    
  <div class="content-wrapper">
        <section class="content-header">
            <div class="container-fluid">
                <div class="row mb-2">
                    <div class="col-sm-6">
                        <h1 class="m-0 text-dark">@currentTitle</h1>
                    </div>
                    <div class="col-sm-6">
                        breadcrumb placeholder
                    </div>
                </div>
            </div>
        </section>

        <section class="content">
            <div class="container-fluid">
                <AppErrorBoundary>
                    @Body
                </AppErrorBoundary>
            </div>
        </section>
    </div>
     @if (IsAutheticated){
    <ControlSidebar />
    <Footer />
     }
</div>