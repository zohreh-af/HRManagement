@using Microsoft.AspNetCore.Components.Routing
@using Microsoft.AspNetCore.Components.Authorization
@using BlazorHRManagement.Web.Components.Pages.Account
@using HRManagement.Persistence.Contexts;

<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <base href="/" />  
    <link href="https://fonts.googleapis.com/css?family=Roboto:300,400,500,700&display=swap" rel="stylesheet" />
    <link href=@Assets["_content/MudBlazor/MudBlazor.min.css"] rel="stylesheet" />
    <ImportMap />
    <link rel="icon" type="image/ico" href="favicon.ico" />
    <HeadOutlet />
</head>

<body class="hold-transition sidebar-mini">

<CascadingAuthenticationState>
       

 <Router AppAssembly="@typeof(App).Assembly">
            <Found Context="routeData">
                <AuthorizeRouteView RouteData="@routeData" DefaultLayout="@typeof(MainLayout)">
                    <NotAuthorized>
                    <Login />
@*                     <DynamicComponent Type="typeof(BlazorHRManagement.Web.Components.Pages.Account.Login)" />
 *@
                </NotAuthorized>
                    <Authorizing>
                        Loading..
                    </Authorizing>
                </AuthorizeRouteView>
                <FocusOnNavigate RouteData="@routeData" Selector="h1" />
            </Found>
            <NotFound>
                <PageTitle>Not found</PageTitle>
                <LayoutView Layout="@typeof(MainLayout)">
                    <p role="alert">Nothing is here</p>
                </LayoutView>
            </NotFound>
        </Router>
</CascadingAuthenticationState>
<script src="@Assets["_content/MudBlazor/MudBlazor.min.js"]"></script>

 </body>

</html>